# 整頓 C6 (DG-CONSOLIDATION-v1 C-2, 2026-09-02): product/platform flags below default to
# true (the personal-pilot posture). The safety-posture group (AUTHORIZATION_MODE, OIDC_*,
# SERVICE_TOKEN_AUTH, IDENTITY_ADMIN, ALLOW_HIGH_RISK_SELF_APPROVAL, NODE_*, ALLOW_ROOT_SSH)
# and the execution-attempt chain stay off; tests/test_pilot_posture.py is the single source.
# 複製這個檔案為 .env 後依需要調整；未設定的變數會用程式內建預設值。
# 絕對不要把真的密碼/金鑰內容寫進這個檔案或 commit 進 git，這裡只放
# 「設定值」，實際憑證一律用檔案路徑（見 servers.yaml 的 key 欄位）
# 或部署環境自己的機密管理方式注入。

# --- 服務綁定（鐵律第 4 條：只綁私網，不綁 0.0.0.0） ---
API_HOST=127.0.0.1
API_PORT=8000
# Product API v2 routes stay registered for a stable OpenAPI contract, but
# runtime access remains hidden until the v2 rollout gate is explicitly opened.
API_V2_ENABLED=true
PRODUCT_RBAC_V2_ENABLED=true
# Requires both gates above; rollback hides bootstrap routes without deleting
# Migration v7 resources, approvals, or durable audit evidence.
PROJECT_BOOTSTRAP_V2_ENABLED=true
# Sibling gate for immutable Host Environment create/update/archive. It does
# not require Project Bootstrap to stay enabled and never deletes v7 data.
PROJECT_ENVIRONMENTS_V1_ENABLED=true
# Typed Run Template and Project Defaults package; additionally requires the
# Environment package because every typed spec binds an exact Environment head.
RUN_TEMPLATE_V2_ENABLED=true
# Product ExecutionPlan v2 preview/submit and approval materialization. Requires
# API v2, Product RBAC, Host Environments, Run Templates, and Dataset Assets.
RUN_EXPERIENCE_V2_ENABLED=true
# Dataset assets, explicit legacy-snapshot adoption, immutable aliases, and
# lineage/usage reads. Requires API v2 and Product RBAC; rollback preserves
# Migration v8 rows and all approval/audit evidence.
DATASET_ASSETS_V2_ENABLED=true
DATASET_SHARING_V2_ENABLED=true
# Approval-backed new-asset publish. Requires API v2, Product RBAC, Dataset
# Assets, and both Dataset Snapshot gates; rollback preserves building/published
# snapshots, assets, aliases, lineage, approvals, idempotency and audit evidence.
DATASET_PUBLISH_V2_ENABLED=true
# Comma-separated canonical absolute Server A roots. Empty disables local-path
# publish but does not make compute ServerConfig.dataset_roots eligible.
DATASET_PUBLISH_LOCAL_ROOTS=
# 單 process 維持 all；拆分部署時 API 副本設 api，唯一/競逐 leader lease
# 的背景工作副本設 scheduler。api role 絕不啟動派工或維運背景迴圈。
PROCESS_ROLE=all

# --- 檔案路徑 ---
DB_PATH=jobqueue.db
AUDIT_PATH=audit.jsonl
# Optional PROCESS_ROLE=all/worker loop that drains durable audit export
# operations into AUDIT_PATH under the database lease.  It is off by default;
# review the output/retention and external-anchor policy before enabling it.
# AUDIT_EXPORT_WORKER_ENABLED=false
# Default-on compatibility summaries for already-durable Job/server evidence.
# Set false only after durable event export/retention evidence is accepted;
# durable DB events and rejection/error audit records are unaffected.
LEGACY_AUDIT_JSONL_ENABLED=true
# 選填：deploy/backup.sh 的備份根目錄。設定後 metrics 會回報最新備份年齡；
# DG-OPS-SLO 核准前不套用任何告警或 readiness 數字門檻。
# BACKUP_ROOT=./backups

# --- 迴圈頻率（秒） ---
MONITOR_INTERVAL_SEC=20
SCHEDULER_INTERVAL_SEC=10

# --- DG-DATASET-SNAPSHOT-v1（預設關閉）-------------------------------
# Request/preview 與 local ArtifactStore workflow 的開關；publish 需同時
# 開啟兩把鎖，且 store root 必須通過 local-filesystem preflight。
# DATASET_SNAPSHOT_V1_ENABLED=true
# DATASET_SNAPSHOT_PUBLISH_ENABLED=true
# DATASET_SNAPSHOT_STORE_ROOT=dataset_store
# DATASET_SNAPSHOT_MAX_BYTES=214748364800

# --- SSH 逾時與併發（秒 / 數量） ---
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
SSH_MAX_CONCURRENCY=8

# --- 認證與 Goal 1 身分相容性 ---
# AUTH_TOKEN 有設定或 OIDC_ENABLED=true 時，application API 要求有效
# credential，否則回 401。
# 公開範圍只有 GET /、GET /auth/login、GET /auth/callback 與 /static/*；
# 後兩個 /auth 路徑只是 OIDC handshake，GET /auth/me 與 POST
# /auth/logout 仍然需認證。OIDC 停用時 login/callback 回 404。
# AUTH_TOKEN 不設定且 OIDC_ENABLED=false 才是不驗證的本機開發模式。
# AUTH_TOKEN=
# Goal 1 相容期預設保留共享 token，並將它標記成 legacy-admin 身分。
LEGACY_SHARED_TOKEN_ENABLED=true
# Service account bearer token 預設只做 schema/readiness，不接受登入；需要時
# 明確開啟。AUTH_TOKEN/X-Auth-Token 相容路徑不受這個開關影響。
SERVICE_TOKEN_AUTH_ENABLED=false
# Authorization modes: `off` preserves the compatibility behavior; `shadow`
# records would-deny evidence without changing responses; `enforce` applies
# the route-action policy fail-closed and filters project-scoped collections.
# Keep `off` until the reviewed enforcement rollout evidence is complete.
AUTHORIZATION_MODE=off
# Trusted-team acceleration. Keep false for separation of duties; true lets an
# otherwise-authorized human decide their own high-risk approval. Service
# actors, immutable payload checks, RBAC, and durable audit remain enforced.
ALLOW_HIGH_RISK_SELF_APPROVAL=false
# 伺服器端 session cookie 名稱（cookie 的建立/安全屬性由 OIDC 流程負責）。
SESSION_COOKIE_NAME=dispatch_session

# --- Goal 1 / Slice 7：瀏覽器 OIDC 登入（預設關閉）---
# 下面四個主要值必須同時設好才能開啟。Issuer 與 callback 只接受
# HTTPS；callback 必須精確是 /auth/callback，不可帶 query/fragment。
# 先在 IdP 註冊 confidential web client，啟用 Authorization Code flow，
# 並將完全相同的 OIDC_REDIRECT_URI 登記為 allowlisted callback。
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com/tenant
# OIDC_CLIENT_ID=dispatch-center
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://dispatch.example.com/auth/callback

# 空白分隔的 scope；openid 必填。profile/email 只用來顯示 metadata。
OIDC_SCOPES=openid profile email
# 逗號分隔、區分大小寫、精確的 OIDC `sub`。必須在該主體第一次
# 建立 issuer+subject binding 前設好；email 不參與識別或管理員決定。
# 登入過的既有 actor 後來才加入此清單，不會被提升。留空表示不 bootstrap。
# OIDC_PLATFORM_ADMIN_SUBJECTS=00u1exactSubject,00u2exactSubject

# 登入 flow 預設 10 分鐘；session 預設 8 小時。兩種 cookie 名稱必須不同。
OIDC_LOGIN_FLOW_TTL_SEC=600
OIDC_SESSION_TTL_SEC=28800
OIDC_FLOW_COOKIE_NAME=dispatch_oidc_flow
# discovery/token/JWKS timeout 與 ID token 時鐘偏差容許值（秒，0..300）。
# Discovery metadata/JWKS 各在 process 內 cache 300 秒；重啟會清除 cache。
OIDC_PROVIDER_TIMEOUT_SEC=10
OIDC_CLOCK_SKEW_LEEWAY_SEC=60

# OIDC cookie 固定為 Secure + HttpOnly + SameSite=Lax，因此瀏覽器必須以
# HTTPS 連到 Dispatch Center。反向代理、LB、APM/WAF 不得記錄 callback
# query/Location、request Cookie/Authorization/X-Auth-Token、response Set-Cookie，
# 或 provider token-exchange request/response body。應用的 Uvicorn filter 只
# 會遮蔽 callback request target，不能保護上游 header 或 egress trace。
# 應用不會儲存 IdP access token 或 refresh token。
# Goal 1 身分管理 API 預設停用。設回 false 是管理介面的回退開關；不會改變
# service-token 認證、不會刪除或撤銷身分資料，也不會啟用 authorization enforcement。
IDENTITY_ADMIN_ENABLED=false

# --- 階段 3 起才會用到（sync 任務本地執行、快取地圖校正）---
# sync 任務在 Server A 本地執行時，agent_jobs/{id}/... 這類相對路徑會相對
# 這個目錄解析（等同工作機的 SSH 登入 home 目錄，只是這裡是本機）。
# 預設用啟動服務當下的工作目錄，正式部署建議設成明確的絕對路徑。
LOCAL_HOME_DIR=.
# 每隔多久 SSH 各機 `ls -d datasets/*/*/` 校正一次 dataset_cache（秒）。
DATASET_RECONCILE_INTERVAL_SEC=3600

# --- 階段 4：Email 通知（app/mailer.py）---
# host/port/from/to 任一沒填，send_mail() 會記 log 後直接跳過（回傳
# False），系統照常運作。SMTP_USER/SMTP_PASS 允許留空（部分內網 relay
# 不需要認證）；有填的話會在 STARTTLS 之後呼叫 SMTP LOGIN。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=dispatch-center@example.com
# MAIL_TO=you@example.com

# --- 階段 4：結果回收 ---
# 任務 done 後從工作機拉 results/{id}/ 回本地 results/{id}/ 的 rsync 逾時
# （秒）。拉不到（工作機本來就沒有 results/{id}/、逾時等）不影響任務狀態，
# 只記稽核 result_pull_failed。
RESULT_PULL_TIMEOUT_SEC=600

# --- 階段 4：卡死偵測 ---
# job.log 超過幾分鐘沒有增長就標 stalled_suspect 旗標（不改 status）並寄一
# 封提醒信（只寄一次，去重）。
STALL_MINUTES=30

# --- 階段 5：LLM（選用；app/llm.py）---
# 沒有安裝 anthropic 套件，或沒設定 ANTHROPIC_API_KEY，聊天（WS /ws）自動
# 降級為規則式後備（「狀態」「任務」「跑 <指令>」三種用法）、失敗診斷
# （POST /jobs/{id}/diagnose）回 503、信件不附加 AI 摘要——前四階段所有
# 功能完全不受影響（鐵律第 1 條）。
# ANTHROPIC_API_KEY=
# 預設模型 claude-sonnet-5，需要的話可以覆蓋：
# LLM_MODEL=claude-sonnet-5
# DG-ASSISTANT-CLAUDE-TURN v1 C2（2026-08-26 使用者裁定）：「AI 供應商」面板
# 的 Anthropic API key 直接執行例外會原子改寫這個檔案（.env.bak 備份、
# chmod 600、值永不入 DB／稽核／回應）。預設是這份 .env 自己；一般不需要改。
# ENV_FILE_PATH=.env

# --- 階段 7：本地 vLLM Agent Layer（選用；app/llm_local.py／
# app/agent_runtime.py／app/agent_tools.py）---
# VLLM_BASE_URL/VLLM_MODEL 兩者都要設定，本地 agent 才會啟用
# （app.llm_local.is_vllm_available()）；沒設定時 WS /ws、POST /agent/chat
# 等入口一律明確降級（WS 退回 anthropic/規則式；/agent/chat 回 503），
# 不影響前六階段任何行為。
# 注意 port：調度中心自己綁 API_PORT（預設 8000），vLLM 服務**不要**也用
# 8000，建議另外綁 8001，兩個服務才不會互相衝突。
# VLLM_BASE_URL=http://127.0.0.1:8001/v1
# VLLM_MODEL=qwen3-coder-30b
# 選填：vLLM 用 `--api-key <key>` 啟動時才需要設定，會在每個請求上加
# `Authorization: Bearer <key>`；沒有 --api-key 的部署留空即可，不影響
# VLLM_BASE_URL/VLLM_MODEL 是否視為「已啟用」的判斷。
# VLLM_API_KEY=
# JSON tool loop（app/agent_runtime.py）每次請求最多呼叫幾次工具，超過就
# 終止並回覆「已達工具呼叫上限」。
AGENT_MAX_TOOL_STEPS=6
# POST /agent/chat／WS /ws（走本地 agent 時）的併發上限，避免同時打爆單張
# GPU 上的 vLLM 服務。
AGENT_MAX_CONCURRENCY=2
# 工具呼叫結果回饋給模型前統一截斷的字元數上限。
AGENT_TOOL_RESULT_MAX_CHARS=4000

# --- 階段 8：Web Server Management（app/server_config.py）---
# 新增/更新機器時，user 是否允許填 root（不建議，預設 false=不允許）。
# ALLOW_ROOT_SSH=true
# ALLOW_ROOT_SSH=false

# 新增/更新機器時，key（SSH 私鑰路徑）必須落在這些目錄底下才會通過驗證
# （逗號分隔，用 os.path.realpath 正規化後比較，防 ../ 繞過）。沒設定時
# 預設只允許 ~/.ssh。私鑰內容本身永遠不會被讀取、上傳或回傳——這裡填的是
# 「Server A（本機）上的路徑」，不是私鑰內容。
# SSH_KEY_ALLOWED_DIRS=~/.ssh

# 選填：servers.yaml 的路徑（預設 servers.yaml，相對於服務啟動時的工作目
# 錄）。server_add/server_update/server_disable/server_delete 核准後會用
# 這個路徑做「先備份、再原子寫入」。
# SERVERS_YAML_PATH=servers.yaml

# --- 階段 10：核准流減摩擦（PLAN.md K 節，見 README「核准流」章節）---
# source="web" 的派工/停止請求是否在同一個請求內直接生效（提案者＝批准
# 者，二次點擊視為純儀式）。預設開啟；設 false 恢復兩步（建立待核准請求
# -> 另外到「總覽」分頁按核准）。
WEB_DIRECT_EXECUTE=true

# 自動核准規則檔路徑（見 auto_approve.yaml.example 的語法說明）。檔案不
# 存在＝沒有規則＝一切照舊出核准卡（安全預設），不需要先建立這個檔案才能
# 啟動服務。改規則檔不用重啟服務，下一次評估就會生效（mtime 變了才重讀）。
# AUTO_APPROVE_RULES_PATH=auto_approve.yaml

# --- 階段 13 v2：Central Codex Runner（README §13，PLAN.md N 節）---

# 指定哪一台既有伺服器（servers.yaml 的 server name）是 Codex Runner——
# 只有這台要安裝/登入 Codex CLI，其他運算機不需要 Codex 帳號或憑證。
# **未設定＝Codex 功能整體停用**（服務照常啟動，coding 相關請求回 400）；
# 設了但 server 不存在或 disabled → 服務啟動失敗（設了就要設對）。
# 建議 server-c；pro6000 不可（SSH user 是 root＋容器環境）。

# Runner 上所有 worktree／mirror／輸出／bundle 的根目錄（home 相對）。

# 同時執行的 coding job 數上限。CODEX_AUTH_MODE=chatgpt 時強制 1（設更大
# 會被降回 1 並記 warning）。

# true＝Runner 保留給 coding 任務（一般訓練任務不派給它，明確 pin 到它的
# 除外）；false＝空閒時可接一般任務，但 coding 永遠優先。

# 是否允許 Codex sandbox 內連網。開了也不允許 sudo/apt/改系統 Python；
# 套件只能裝進 worktree 內 .venv、uv 或 conda 環境（guardrail 前言注入）。

# Plan v2 Slice 2 immutable Engineering Task backend。false 時新 structured
# request endpoint 停用，既有 /coding-task-request 與 Coding Runs 完全保留；
# true 時新任務必須選 ProjectVersion，Hub bundle 在人工核准後才 staging。

# D2 雙鑰匙 interlock：backend 開啟時必須同時設下面這把鑰匙，否則啟動即拒絕。
# 名稱直說風險——post-turn Git finalization 目前仍在 Codex sandbox 外執行；
# 正式環境啟用另需 D2 finalization sandbox（docs/AI_ENGINEERING_DECISION_GATE.md）。
# ENGINEERING_TASK_BACKEND_V1_ACCEPT_UNSANDBOXED_FINALIZATION=false

# DG-CODE-PROMOTE-v1：人工核准後將 verified changes.bundle publish 到本機
# Hub 並建立 runnable ProjectVersion。與 Engineering Task backend 分開，
# 預設 false；不會 push GitHub，也不會刪 worktree/bundle。
CODE_PROMOTION_V1_ENABLED=true

# chatgpt（ChatGPT Plus 訂閱額度、強制單一序列化）或 api_key（API 計費，
# 登入用 `printenv OPENAI_API_KEY | codex login --with-api-key`）。

# --- 階段 9：MCP Bridge（app/mcp_bridge.py，`python -m app.mcp_bridge`）---
# 獨立行程，讓 ChatGPT custom connector 透過 Cloudflare Tunnel 唯讀查詢
# 調度中心狀態（見 README「ChatGPT 串接（MCP Bridge）」章節）。不 import
# 任何 app.* 模組，只透過下面這幾個變數 + httpx 呼叫調度中心既有 REST API。

# bridge 呼叫調度中心 REST API 的 base URL（不是 bridge 自己的 port）。
# DISPATCH_BASE_URL=http://127.0.0.1:8888
# 選填：bridge 呼叫調度中心時使用的 service-account bearer token。設定後會
# 送 Authorization: Bearer，且本體必須同時設 SERVICE_TOKEN_AUTH_ENABLED=true；
# AUTH_TOKEN 若也有設定，既有 X-Auth-Token 仍會同時送出，便於相容期回退。
# Bridge 不轉送瀏覽器 OIDC cookie；OIDC-only 且兩種 machine credential 都沒有
# 時，本體會回 401。這和保護 bridge 入站的 MCP_BRIDGE_TOKEN 是不同憑證。
# DISPATCH_SERVICE_TOKEN=

# bridge 自己監聽的 port，只綁 127.0.0.1（鐵律第 4 條），對外一律靠
# cloudflared 隧道，不會、也不該直接暴露在公網。
# MCP_BRIDGE_PORT=8890

# **必填**（bridge 沒設定這個就會拒絕啟動）：MCP 端點掛在
# `/mcp-{這個值}` 底下，是 ChatGPT connector 連進來的第一道防線（路徑機密
# 錯誤一律回 404，不透露端點存在）。生成方式：
#   openssl rand -hex 24
# MCP_BRIDGE_PATH_SECRET=

# 選填：第二道防線。有設定時，request 若帶了 Authorization: Bearer header
# 就必須完全等於這個值，否則 401；沒帶 Authorization header（路徑機密正確
# 的前提下）仍會放行——相容 ChatGPT connector 目前介面選「不需要驗證」的
# 模式。
# MCP_BRIDGE_TOKEN=

# ---- Goal 2 自動調度（docs/GOAL_2_AUTOMATED_DISPATCH_PLAN.md）----------
# 全部預設關閉/停用；逐一開啟才會啟動對應能力。
# RUN_PROFILE_V1_ENABLED=true          # D5 Run Profile（typed 執行設定）管理介面
# DISPATCH_POLICY_V1_ENABLED=true      # 調度政策管理介面（政策本身無運行效果）
# AUTO_PLACEMENT_PROPOSALS_ENABLED=true # 依政策對閒置機器建立 pending 提案
# AUTO_PLACEMENT_INTERVAL_SEC=300       # 提案迴圈掃描間隔（秒）
# AUTO_PLACEMENT_COOLDOWN_SEC=3600      # 同 (政策,機器) 組合的提案冷卻（秒）
# AUTO_PLACEMENT_KILL_SWITCH=true       # true=提案仍需人工核准；false=政策範圍內自動核准
# SERVER_OBSERVATIONS_ENABLED=true      # monitor 探測落地 server_observations
# SERVER_OBSERVATION_RETENTION_DAYS=14  # 觀測資料保留天數

# ---- Goal 3 Phase B 空伺服器 bootstrap（DG-B，docs/DECISIONS.md）--------
# SERVER_BOOTSTRAP_V1_ENABLED=true     # server_bootstrap 核准流程與報告閘

# ---- Goal 3 B4 新機 dataset 預熱（DG-B4，docs/DECISIONS.md 2026-07-25）--
# 兩把煞車都要撥開才會提案：ENABLED=true **且** KILL_SWITCH=false。
# 提案永遠只建 pending approval，dataset_prewarm 不在自動核准白名單。
# DATASET_PREWARM_V1_ENABLED=true      # 預熱提案總開關
# DATASET_PREWARM_KILL_SWITCH=true      # true=停用提案（第二把保險）
# DATASET_PREWARM_INTERVAL_SEC=300      # 預熱迴圈掃描間隔（秒）
# DATASET_PREWARM_COOLDOWN_SEC=3600     # 同 (機器,資料集,版本) 的提案冷卻（秒）

# ---- Goal 3 C2 Node Agent 協議（DG-C，INV-NODE-*）------------------------
# 預設關閉：protocol/drain 與 new-assignment 分開，方便先 drain 再回退 SSH。
# NODE_AGENT_V1_ENABLED=false           # deprecated 舊 alias；設定時會警告，仍同時開兩者
# NODE_PROTOCOL_DRAIN_ENABLED=false    # poll/current/heartbeat/terminal/API
# NODE_PROTOCOL_ALLOW_MISSING_VERSION=false  # temporary legacy-agent compatibility
# NODE_NEW_ASSIGNMENT_ENABLED=false    # 是否允許主控給 node 新工作
# NODE_ROTATION_OVERLAP_SEC=300        # routine credential rotation overlap
# NODE_ROTATION_PENDING_TTL_SEC=86400  # pending token activation deadline
# NODE_AGENT_LEASE_TTL_SEC=120          # agent 必須在這麼多秒內 acknowledge
# NODE_AGENT_HEARTBEAT_TTL_SEC=60       # 心跳新鮮度門檻
# NODE_AGENT_HEARTBEAT_GRACE_SEC=60     # 超過 TTL+grace 判 unknown（不是 failed）
# Node Agent 工作機環境（寫入 worker 的 0600 EnvironmentFile，不是 control
# plane secret）：
# DISPATCH_CONTROL_PLANE_URL=https://dispatch.example.internal
# DISPATCH_NODE_TOKEN=dcn_...            # 只放 worker，不進 argv/log
# DISPATCH_NODE_WORKDIR=~/.dispatch-node-agent
# DISPATCH_NODE_POLL_INTERVAL_SEC=10
# DISPATCH_NODE_HEARTBEAT_INTERVAL_SEC=30
# DISPATCH_NODE_REQUEST_TIMEOUT_SEC=20
# DISPATCH_NODE_BACKOFF_MAX_SEC=300
# DISPATCH_NODE_BACKOFF_JITTER_SEC=1
# DISPATCH_NODE_STOP_GRACE_SEC=30
# DISPATCH_NODE_ISOLATION_MODE=direct       # direct rollback; systemd for isolated units
# DISPATCH_NODE_DEPLOYMENT_TIER=development # canary/production require systemd

# ---- Goal 3 Phase D-1 多 Codex Runner pool ------------------------------
# 逗號分隔的 Runner 名單（每個都必須是 servers.yaml 既有且 enabled 的
# server）。只設 CODEX_RUNNER_SERVER＝單 Runner 舊語意；只設本值＝primary
# 取第一個；兩者都設時 CODEX_RUNNER_SERVER 必須是成員。每台 Runner 各自
# 承擔 CODEX_MAX_CONCURRENCY，新 coding 工作綁定 active 數最少的 Runner。

# ---- Goal 3 C3 Node Agent canary 資格（roadmap Phase 3）------------------
# 只有 require_tag 精確等於這個值的**普通**任務（train/adhoc）才可以被
# Node Agent 領走。coding/sync/setup 永遠不合格。
#
# **預設空字串＝沒有任何任務合格**。這是第三道煞車：開了
# NODE_NEW_ASSIGNMENT_ENABLED、把機器設成 execution_backend: node，**仍然**不會
# 有任何工作流到 agent 上——你必須再逐個任務標上這個 tag，canary 才開始。
# NODE_CANARY_REQUIRE_TAG=

# 助手（runner Claude）的目標模型；空值＝CLI 預設。可由「AI 供應商」面板設定。
# ASSISTANT_CLAUDE_MODEL=

# DG-ASSISTANT-TOOLS v1：助手回合可經 MCP bridge 使用平台工具（查詢＋建卡）。
# 每回合簽發短效 token（TTL 秒）給 runner；bridge 以此 URL 呼叫 Server A REST。
# ASSISTANT_TOOLS_V1_ENABLED=true
# ASSISTANT_TOOLS_DISPATCH_BASE_URL=https://server-a.example.ts.net
# ASSISTANT_TOOLS_RUNNER_PYTHON=python3
# ASSISTANT_TOOLS_MAX_CALLS=8
# ASSISTANT_TURN_TOKEN_TTL_SEC=150
